    <item>
      <title>[06] SOC 1 and SOC 2 Reports</title>
      <link>http://localhost:1313/docs/04_playbooks/cissp/d1/06-soc-1-2/</link>
      <pubDate>Tue, 30 Jun 2026 00:00:00 +0000</pubDate>
      
      <guid>http://localhost:1313/docs/04_playbooks/cissp/d1/06-soc-1-2/</guid>
      <description>
        
        
        &lt;div style=&#34;margin-top: 1rem; margin-bottom: 2rem; font-size: 0.875rem; color: #6b7280; display: flex; align-items: center; flex-wrap: wrap; gap: 10px;&#34;&gt;
  
    &lt;span style=&#34;display: flex; align-items: center; gap: 6px;&#34;&gt;
      By:
      
        
        
        
        
          
          
          
            
          
          
          &lt;a href=&#34;https://www.linkedin.com/in/prasannavbalaji&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34; style=&#34;display: inline-flex; align-items: center; gap: 4px; font-weight: 600; color: #0a66c2; text-decoration: none; border-bottom: 1px solid transparent;&#34; onmouseover=&#34;this.style.borderBottom=&#39;1px solid #0a66c2&#39;&#34; onmouseout=&#34;this.style.borderBottom=&#39;1px solid transparent&#39;&#34;&gt;
