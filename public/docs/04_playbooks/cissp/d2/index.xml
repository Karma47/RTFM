    <item>
      <title>2.1 Identify and Classify information and assets</title>
      <link>http://localhost:1313/docs/04_playbooks/cissp/d2/2.1-identify-and-classify-information-and-assets/</link>
      <pubDate>Tue, 30 Jun 2026 00:00:00 +0000</pubDate>
      
      <guid>http://localhost:1313/docs/04_playbooks/cissp/d2/2.1-identify-and-classify-information-and-assets/</guid>
